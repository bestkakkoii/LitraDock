[Unit]
Description=Restricted literature demo
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=literature
Group=literature
WorkingDirectory=/opt/literature/current
EnvironmentFile=/etc/literature/service.env
ExecStart=/usr/bin/dotnet /opt/literature/current/LitraDock.Hosted.dll --contentRoot /opt/literature/current
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/literature-demo
UMask=0077
MemoryMax=768M
MemorySwapMax=0
CPUQuota=100%
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
